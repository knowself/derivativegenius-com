# Database Configuration (Drizzle ORM + PostgreSQL / Neon)
DATABASE_URL="postgresql://user:password@ep-example-123456.us-east-1.aws.neon.tech/neondb?sslmode=require"

# Centurion access and keyed suppression hashing (server-only)
CENTURION_ADMIN_USER_IDS="user_clerk_id"
CENTURION_SUPPRESSION_SECRET="replace-with-a-long-random-secret"

# Application URL
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Email / Notification Dispatch (Optional)
SMTP_HOST="smtp.example.com"
SMTP_PORT=587
SMTP_USER="user@example.com"
SMTP_PASS="password"

# Environment
NODE_ENV="development"

# Live Eve audit-agent (optional, server-only). Base URL of a running agent —
# local `eve dev` (e.g. http://127.0.0.1:PORT) or an `eve deploy`ed URL.
# Unset → the prospect audit button uses deterministic static checks only.
# AUDIT_AGENT_URL="http://127.0.0.1:PORT"
# AUDIT_AGENT_TIMEOUT_MS=45000
